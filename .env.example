# Copy to .env (gitignored). Never commit keys.
ANTHROPIC_API_KEY=            # verifier + hold-reason writer (Claude)
FACTORY_API_KEY=              # Droid SDK matcher; or `droid` CLI login
VERIFIER_MODEL=claude-opus-5-5
APPROVAL_THRESHOLD_USD=2500   # above this, APPROVE still routes to a human
HOLD_MINUTES=30               # sim-minutes between pass and re-verify
