# Copy to .env (gitignored). Never commit keys.
ANTHROPIC_API_KEY=            # verifier + hold-reason writer (Claude)
FACTORY_API_KEY=              # Droid SDK matcher; or `droid` CLI login
VERIFIER_MODEL=claude-opus-5-5
APPROVAL_THRESHOLD_USD=2500   # above this, APPROVE still routes to a human
HOLD_MINUTES=30               # sim-minutes between pass and re-verify
APIFY_TOKEN=                  # Apify Actors (EDGAR lease finder, county tax lookup)
SPACETIME_DB=cam-dispute-room # SpacetimeDB maincloud database
SPACETIME_TOKEN=              # `spacetime login show --token`
AGENTVERSE_API_KEY=           # Fetch.ai Agentverse mailbox
CAM_AGENT_SEED=               # long random phrase; the uAgent's private key
SEC_USER_AGENT=               # "Name email" that SEC asks automated clients to send
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
